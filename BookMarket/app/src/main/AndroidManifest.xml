<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.BookMarket">

        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <activity
            android:name=".MenuActivity"
            android:exported="false" />

        <activity
            android:name=".BooksActivity"
            android:exported="false"
            android:label="도서목록"
            android:theme="@style/MyTheme.BookMarket"/>

        <activity
            android:name=".BookActivity"
            android:exported="false"
            android:label="도서상세정보"
            android:theme="@style/MyTheme.BookMarket"/>


        <activity
            android:name=".cart.CartActivity"
            android:exported="false"
            android:label="장바구니"
            android:theme="@style/MyTheme.BookMarket" />

        <activity
            android:name=".order.ShippingActivity"
            android:exported="false"
            android:label="배송정보"
            android:theme="@style/MyTheme.Cart" />

        <activity
            android:name=".order.OrderActivity"
            android:exported="false"
            android:label="주문서"
            android:theme="@style/MyTheme.Cart" />

        <activity
            android:name=".mypage.MyPageActivity"
            android:exported="false"
            android:label="나의 페이지"
            android:theme="@style/MyTheme.BookMarket" />

        <activity
            android:name=".mypage.MemoActivity"
            android:exported="false"
            android:label="메모장"
            android:theme="@style/MyTheme.BookMarket" />

        <activity
            android:name=".marketinfo.MarketInfoActivity"
            android:exported="false"
            android:label="마켓정보"
            android:theme="@style/MyTheme.BookMarket" />

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="인증키" />

        <activity
            android:name=".customerinquiry.BoardActivity"
            android:exported="false"
            android:label="고객문의"
            android:theme="@style/MyTheme.BookMarket" />

        <activity
            android:name=".customerinquiry.DetailBoardActivity"
            android:exported="false"
            android:label="상세보기"
            android:theme="@style/MyTheme.BookMarket" />
    </application>

</manifest>